# Azure OpenAI
AZURE_API_KEY=
AZURE_API_BASE=https://your-resource-name.cognitiveservices.azure.com/
AZURE_API_VERSION=2024-12-01-preview

# Judge model
JUDGE_MODEL=azure/gpt-5.4-mini

# Candidate model used for generation examples
CANDIDATE_MODEL=azure/gpt-5.4-mini

# Optional overrides for pinned GPT-5.6 deployment names
GPT_5_6_LUNA_MODEL=azure/gpt-5.6-luna
GPT_5_6_TERRA_MODEL=azure/gpt-5.6-terra
GPT_5_6_SOL_MODEL=azure/gpt-5.6-sol

# Optional comparison throttle, keep at or below each deployment's RPM quota
DPD_COMPARISON_RPM=60

# Optional full-census controls
DPD_FULL_CENSUS_RPM=60
DPD_FULL_CENSUS_WORKERS=4
DPD_FULL_CENSUS_LUNA_MAX_USD=40
DPD_FULL_CENSUS_TERRA_MAX_USD=90
DPD_FULL_CENSUS_SOL_MAX_USD=170
